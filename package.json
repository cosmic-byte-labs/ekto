{
  "name": "ekto",
  "version": "0.0.0",
  "private": true,
  "description": "Ecto-inspired data layer for TypeScript: schemas, changesets, composable queries and a Repo as the only side-effecting boundary.",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "default": "./dist/sqlite/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate/index.d.ts",
      "default": "./dist/migrate/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "bin": {
    "ekto": "./dist/migrate/bin.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test 'src/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage 'src/**/*.test.ts'",
    "check": "biome check . && tsc --noEmit && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "kysely": "0.29.9",
    "pg": "^8.23.1",
    "sqlite3": "^6.0.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "kysely": "~0.29.9",
    "pg": "^8",
    "sqlite3": "^6"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  }
}
